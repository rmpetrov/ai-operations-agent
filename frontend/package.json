{
  "name": "opspilot-replay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.0 <23" },
  "scripts": {
    "contracts": "node scripts/contracts.mjs --write",
    "contracts:check": "node scripts/contracts.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run contracts:check && tsc --noEmit && vite build",
    "preview": "node scripts/serve.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "~4.0.18"
  }
}
